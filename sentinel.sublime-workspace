			"contents": "/**\n * @file kerneljs.js\n * @author Will Fobbs\n * @version 7.2.0\n * @description KernelJS – Portable Unix‑like kernel with VFS, shell, commands,\n *              and integrated ResourceManager for process, file handle, memory,\n *              CPU, and LLM token limits.\n * @principle \"Assume no dependencies in classes unless authorized.\"\n * @principle \"The AI_Instructions docblock at the bottom provides guidance.\"\n * @features Pluggable storage, file ops, pipelines, redirections, here‑doc,\n *           ResourceManager integration, process tracking, file handle limits.\n */\n\n(function(root, factory) {\n  try { if (root.KernelJS) delete root.KernelJS; } catch(e) {}\n  try { if (root.MemoryBackend) delete root.MemoryBackend; } catch(e) {}\n  if (typeof define === 'function' && define.amd) {\n    define([], factory);\n  } else if (typeof module === 'object' && module.exports) {\n    module.exports = factory();\n  } else {\n    const exports = factory();\n    root.KernelJS = exports.KernelJS;\n    root.MemoryBackend = exports.MemoryBackend;\n  }\n}(typeof self !== 'undefined' ? self : this, function() {\n  // ----------------------------------------------------------------------\n  // MemoryBackend – in‑memory storage (unchanged)\n  // ----------------------------------------------------------------------\nclass MemoryBackend {\n  constructor() {\n    this.files = new Map();\n    this.files.set('/', { type: 'dir', mode: 0o755, mtimeMs: Date.now() });\n  }\n\n  _error(code, message) {\n    const err = new Error(message);\n    err.code = code;\n    return err;\n  }\n\n  // Node‑style readFile: returns Uint8Array, or string if encoding 'utf8'\n  async readFile(path, options = {}) {\n    const node = this.files.get(path);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${path}`);\n    if (node.type !== 'file') throw this._error('EISDIR', `EISDIR: ${path}`);\n    const encoding = typeof options === 'string' ? options : options.encoding;\n    if (encoding === 'utf8') {\n      if (node.data instanceof Uint8Array) return new TextDecoder().decode(node.data);\n      return String(node.data);\n    }\n    // return Uint8Array\n    if (node.data instanceof Uint8Array) return node.data;\n    return new TextEncoder().encode(String(node.data));\n  }\n\n  async writeFile(path, data) {\n    const dir = path.substring(0, path.lastIndexOf('/')) || '/';\n    const dirNode = this.files.get(dir);\n    if (!dirNode || dirNode.type !== 'dir') throw this._error('ENOENT', `ENOENT: parent ${dir}`);\n    let stored = data;\n    if (typeof data === 'string') stored = new TextEncoder().encode(data);\n    else if (data instanceof Uint8Array) stored = data;\n    else if (data instanceof ArrayBuffer) stored = new Uint8Array(data);\n    else stored = new TextEncoder().encode(String(data));\n    this.files.set(path, { type: 'file', data: stored, mtimeMs: Date.now(), mode: 0o644 });\n  }\n\n  async mkdir(path, options = {}) {\n    if (this.files.has(path)) {\n      if (options.recursive) return;\n      throw this._error('EEXIST', `EEXIST: ${path}`);\n    }\n    if (options.recursive) {\n      const parts = path.split('/').filter(p => p);\n      let current = '';\n      for (const part of parts) {\n        current += '/' + part;\n        if (!this.files.has(current)) {\n          await this.mkdir(current, { recursive: false });\n        }\n      }\n      return;\n    }\n    const parent = path.substring(0, path.lastIndexOf('/')) || '/';\n    const parentNode = this.files.get(parent);\n    if (!parentNode || parentNode.type !== 'dir') throw this._error('ENOENT', `ENOENT: parent ${parent}`);\n    this.files.set(path, { type: 'dir', mtimeMs: Date.now(), mode: 0o755 });\n  }\n\n  async readdir(path) {\n    const node = this.files.get(path);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${path}`);\n    if (node.type !== 'dir') throw this._error('ENOTDIR', `ENOTDIR: ${path}`);\n    const entries = [];\n    const prefix = path === '/' ? '/' : path + '/';\n    for (const [p] of this.files) {\n      if (p === path) continue;\n      if (p.startsWith(prefix)) {\n        const rest = p.substring(prefix.length);\n        const first = rest.split('/')[0];\n        if (!entries.includes(first)) entries.push(first);\n      }\n    }\n    return entries;\n  }\n\n  async stat(path) {\n    const node = this.files.get(path);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${path}`);\n    const size = node.type === 'file' ? (node.data instanceof Uint8Array ? node.data.length : node.data.length) : 0;\n    return {\n      isDirectory: () => node.type === 'dir',\n      isFile: () => node.type === 'file',\n      size: size,\n      mtimeMs: node.mtimeMs,\n      mode: node.mode\n    };\n  }\n\n  async rmdir(path) {\n    const node = this.files.get(path);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${path}`);\n    if (node.type !== 'dir') throw this._error('ENOTDIR', `ENOTDIR: ${path}`);\n    for (const p of this.files.keys()) {\n      if (p.startsWith(path + '/')) throw this._error('ENOTEMPTY', `ENOTEMPTY: ${path}`);\n    }\n    this.files.delete(path);\n  }\n\n  async unlink(path) {\n    const node = this.files.get(path);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${path}`);\n    if (node.type !== 'file') throw this._error('EISDIR', `EISDIR: ${path}`);\n    this.files.delete(path);\n  }\n\n  async rename(oldPath, newPath) {\n    const node = this.files.get(oldPath);\n    if (!node) throw this._error('ENOENT', `ENOENT: ${oldPath}`);\n    const newParent = newPath.substring(0, newPath.lastIndexOf('/')) || '/';\n    const parentNode = this.files.get(newParent);\n    if (!parentNode || parentNode.type !== 'dir') throw this._error('ENOENT', `ENOENT: parent ${newParent}`);\n    if (this.files.has(newPath)) throw this._error('EEXIST', `EEXIST: ${newPath}`);\n    this.files.set(newPath, node);\n    this.files.delete(oldPath);\n  }\n}\n\n  // ----------------------------------------------------------------------\n  // ResourceManager – Resource governance\n  // ----------------------------------------------------------------------\n  class ResourceManager {\n    constructor(options = {}) {\n      this.parent = options.parent || null;\n      this.monitor = options.monitor || null;\n      this.reporter = options.reporter || null;\n      this.children = new Set();\n      if (this.parent) this.parent.children.add(this);\n\n      this.processes = new Map();        // pid -> { startTime, memoryEstimateMB, fileHandles, metadata }\n      this.fileHandles = 0;\n      this.totalCPUTimeMs = 0;\n      this.llmTokensUsed = 0;\n\n      this.limits = {\n        maxProcesses: 8,\n        maxFileHandles: 256,\n        maxMemoryMB: 512,\n        maxCPUTimeMs: 10000,\n        maxLLMTokensPerHour: 5000,\n        ...options.limits\n      };\n      this._listeners = new Map();\n    }\n\n    setLimits(newLimits) {\n      Object.assign(this.limits, newLimits);\n      return this;\n    }\n\n    getEffectiveLimits() {\n      const parentLimits = this.parent ? this.parent.getEffectiveLimits() : {};\n      return { ...parentLimits, ...this.limits };\n    }\n\n    reserveProcess(pid, metadata = {}) {\n      const effective = this.getEffectiveLimits();\n      if (this.processes.size >= effective.maxProcesses) {\n        this._report('process_limit', { pid, limit: effective.maxProcesses });\n        return false;\n      }\n      this.processes.set(pid, {\n        startTime: Date.now(),\n        memoryEstimateMB: metadata.estimatedMemoryMB || 0,\n        fileHandles: 0,\n        metadata\n      });\n      return true;\n    }\n\n    releaseProcess(pid, stats = {}) {\n      const proc = this.processes.get(pid);\n      if (!proc) return;\n      const cpu = stats.cpuTimeMs || (Date.now() - proc.startTime);\n      this.totalCPUTimeMs += cpu;\n      this.fileHandles -= proc.fileHandles;\n      this.processes.delete(pid);\n      this._checkCpuLimit();\n    }\n\n    reserveFileHandle() {\n      const effective = this.getEffectiveLimits();\n      if (this.fileHandles + 1 > effective.maxFileHandles) {\n        this._report('file_handle_limit', { current: this.fileHandles });\n        return false;\n      }\n      this.fileHandles++;\n      return true;\n    }\n\n    releaseFileHandle() {\n      if (this.fileHandles > 0) this.fileHandles--;\n    }\n\n    updateMemory(pid, usedMB) {\n      const proc = this.processes.get(pid);\n      if (!proc) return true;\n      proc.memoryEstimateMB = usedMB;\n      return this._checkMemoryLimit();\n    }\n\n    _checkMemoryLimit() {\n      const effective = this.getEffectiveLimits();\n      let total = 0;\n      for (const proc of this.processes.values()) total += proc.memoryEstimateMB;\n      if (total > effective.maxMemoryMB) {\n        this._report('memory_limit', { usedMB: total, limitMB: effective.maxMemoryMB });\n        return false;\n      }\n      return true;\n    }\n\n    _checkCpuLimit() {\n      const effective = this.getEffectiveLimits();\n      if (this.totalCPUTimeMs > effective.maxCPUTimeMs) {\n        this._report('cpu_time_limit', { totalMs: this.totalCPUTimeMs });\n      }\n    }\n\n    reserveLLMTokens(tokens) {\n      const effective = this.getEffectiveLimits();\n      if (this.llmTokensUsed + tokens > effective.maxLLMTokensPerHour) {\n        this._report('llm_token_limit', { requested: tokens, used: this.llmTokensUsed });\n        return false;\n      }\n      this.llmTokensUsed += tokens;\n      return true;\n    }\n\n    _report(event, data) {\n      if (this.reporter) this.reporter(event, data, this);\n      this._emit('limit_exceeded', { event, data });\n      if (this.parent) this.parent._report(event, data);\n    }\n\n    on(event, cb) {\n      if (!this._listeners.has(event)) this._listeners.set(event, new Set());\n      this._listeners.get(event).add(cb);\n    }\n\n    _emit(event, data) {\n      const listeners = this._listeners.get(event);\n      if (listeners) listeners.forEach(cb => { try { cb(data); } catch(e) {} });\n    }\n\n    stats() {\n      let totalMemory = 0;\n      for (const proc of this.processes.values()) totalMemory += proc.memoryEstimateMB;\n      return {\n        activeProcesses: this.processes.size,\n        fileHandles: this.fileHandles,\n        totalCPUTimeMs: this.totalCPUTimeMs,\n        llmTokensUsed: this.llmTokensUsed,\n        estimatedMemoryMB: totalMemory,\n        limits: this.getEffectiveLimits()\n      };\n    }\n\n    destroy() {\n      if (this.parent) this.parent.children.delete(this);\n      for (const child of this.children) child.destroy();\n      this._listeners.clear();\n    }\n  }\n\n  // ----------------------------------------------------------------------\n  // KernelJS main class with ResourceManager integration\n  // ----------------------------------------------------------------------\n  class KernelJS {\n    constructor(storage, options = {}) {\n      this.storage = storage;\n      this.pfs = storage;\n      this.cwd = '/';\n      this.paths = ['/bin', '/usr/bin', '/usr/local/bin'];\n      this._editorFn = null;\n      this._commandCache = new Map();\n\n      // ResourceManager integration\n      const { resourceManager = null, resourceMonitor = null, ...otherOpts } = options;\n      this.rm = resourceManager || new ResourceManager({\n        limits: { maxProcesses: 8, maxFileHandles: 256, maxMemoryMB: 512, maxCPUTimeMs: 10000 },\n        monitor: resourceMonitor,\n        reporter: (event, data) => this._logResourceEvent(event, data)\n      });\n      // Optional: store reference to monitor if provided\n      this.resourceMonitor = resourceMonitor;\n    }\n\n    _logResourceEvent(event, data) {\n      console.warn(`[ResourceManager] ${event}:`, data);\n      // Could also emit to event bus or write to /var/log/resource.log\n    }\n\n    // ----- File system operations (with file handle tracking) -----\n    async mkdir(path) {\n      if (!path || path === '/') return;\n      // mkdir does not consume a persistent file handle – skip reservation\n      try { await this.storage.mkdir(path, { recursive: true }); }\n      catch (err) { if (err.code !== 'EEXIST') throw err; }\n    }\n\n    async writeFile(path, content) {\n      if (!this.rm.reserveFileHandle()) {\n        throw new Error('EMFILE: too many open files');\n      }\n      try {\n        const lastSlash = path.lastIndexOf('/');\n        if (lastSlash > 0) {\n          const dir = path.substring(0, lastSlash);\n          await this.mkdir(dir);\n        }\n        await this.storage.writeFile(path, content);\n      } finally {\n        this.rm.releaseFileHandle();\n      }\n    }\n\n    async readFile(path) {\n      if (!this.rm.reserveFileHandle()) {\n        throw new Error('EMFILE: too many open files');\n      }\n      try {\n        return await this.storage.readFile(path, 'utf8');\n      } finally {\n        this.rm.releaseFileHandle();\n      }\n    }\n\n    async readBinary(path) {\n      if (!this.rm.reserveFileHandle()) {\n        throw new Error('EMFILE: too many open files');\n      }\n      try {\n        const data = await this.storage.readFile(path);\n        return data instanceof Uint8Array ? data : new Uint8Array(data);\n      } finally {\n        this.rm.releaseFileHandle();\n      }\n    }\n\n    async writeBinary(path, data) {\n      // writeFile already reserves handle; we can just call it\n      await this.writeFile(path, data);\n    }\n\n    async exists(path) {\n      // exists uses stat – no persistent handle needed, skip reservation\n      try { await this.storage.stat(path); return true; }\n      catch (err) { if (err.code === 'ENOENT') return false; throw err; }\n    }\n\n    async copy(src, dest) {\n      const content = await this.readFile(src);\n      await this.writeFile(dest, content);\n    }\n\n    async dir(path = '/') {\n      // readdir does not need a persistent handle – skip\n      const entries = await this.storage.readdir(path);\n      const items = [];\n      for (const name of entries) {\n        const fullPath = path === '/' ? `/${name}` : `${path}/${name}`;\n        const stat = await this.storage.stat(fullPath);\n        items.push({\n          Name: name,\n          Type: stat.isDirectory() ? '📁' : '📄',\n          Size: stat.isDirectory() ? '-' : this._formatBytes(stat.size),\n          Modified: new Date(stat.mtimeMs).toLocaleString()\n        });\n      }\n      return items;\n    }\n\n    async stat(path) {\n      // stat is transient – no handle needed\n      return await this.storage.stat(path);\n    }\n\n    async rename(oldPath, newPath) {\n      // rename does not open a file – skip handle\n      await this.storage.rename(oldPath, newPath);\n    }\n\n    async delete(path) {\n      try {\n        const stat = await this.storage.stat(path);\n        if (stat.isDirectory()) {\n          const children = await this.storage.readdir(path);\n          for (const child of children) {\n            const childPath = path === '/' ? `/${child}` : `${path}/${child}`;\n            await this.delete(childPath);\n          }\n          await this.storage.rmdir(path);\n        } else {\n          await this.storage.unlink(path);\n        }\n      } catch (err) { if (err.code !== 'ENOENT') throw err; }\n    }\n\n    async readClass(path) {\n      const code = await this.readFile(path);\n      const moduleObj = { exports: {} };\n      const fn = new Function('module', 'exports', code + '; return module.exports;');\n      let exported = fn(moduleObj, moduleObj.exports);\n      if (exported && typeof exported === 'object') {\n        if (exported.default && typeof exported.default === 'function') exported = exported.default;\n        else if (exported.Ops && typeof exported.Ops === 'function') exported = exported.Ops;\n        else if (exported.Tensor && typeof exported.Tensor === 'function') exported = exported.Tensor;\n      }\n      return exported;\n    }\n\n    async saveJSON(path, obj) {\n      const json = JSON.stringify(obj, null, 2);\n      await this.writeFile(path, json);\n    }\n\n    async loadJSON(path) {\n      const json = await this.readFile(path);\n      return JSON.parse(json);\n    }\n\n    _formatBytes(bytes) {\n      if (typeof bytes !== 'number' || isNaN(bytes) || bytes === 0) return '0 B';\n      const k = 1024;\n      const sizes = ['B', 'KB', 'MB', 'GB'];\n      const i = Math.floor(Math.log(bytes) / Math.log(k));\n      let val = bytes / Math.pow(k, i);\n      val = Math.round(val * 100) / 100;\n      const formatted = val % 1 === 0 ? val.toFixed(0) : val.toFixed(2).replace(/\\.?0+$/, '');\n      return `${formatted} ${sizes[i]}`;\n    }\n\n    // ----- Paste / clipboard (unchanged) -----\n    async getCopy() { /* ... same as before ... */ return ''; } // abbreviated for brevity\n    async paste(path) { /* ... same ... */ return { path, length: 0 }; }\n\n    // ----- Shell execution with process tracking -----\n    setEditor(fn) { this._editorFn = fn; }\n\n    _createStdinIterable(str) {\n      const encoder = new TextEncoder();\n      const data = encoder.encode(str);\n      let done = false;\n      return {\n        [Symbol.asyncIterator]() {\n          return {\n            next() {\n              if (done) return Promise.resolve({ done: true });\n              done = true;\n              return Promise.resolve({ value: data, done: false });\n            }\n          };\n        }\n      };\n    }\n\n    _createOutputCollector() {\n      let buffer = '';\n      return {\n        write(chunk) {\n          if (typeof chunk === 'string') buffer += chunk;\n          else buffer += new TextDecoder().decode(chunk);\n        },\n        get() { return buffer; }\n      };\n    }\n\n    async run(commandLine) {\n      const pipeline = this._parseCommandLine(commandLine);\n      if (pipeline.length === 0) return { stdout: '', stderr: '', exitCode: 0 };\n      let input = null;\n      let lastStderr = '';\n      let lastExitCode = 0;\n      for (let i = 0; i < pipeline.length; i++) {\n        const cmd = pipeline[i];\n        let stdinIter = null;\n        if (i === 0) {\n          if (cmd.hereDoc && cmd.hereDoc.content) {\n            stdinIter = this._createStdinIterable(cmd.hereDoc.content);\n          } else if (cmd.stdinFile) {\n            const content = await this.readFile(cmd.stdinFile);\n            stdinIter = this._createStdinIterable(content);\n          }\n        } else {\n          if (input !== null) {\n            stdinIter = this._createStdinIterable(input);\n          }\n        }\n        const result = await this._executeCommand(\n          cmd.command, cmd.args, stdinIter,\n          cmd.stdoutFile, cmd.stdoutAppend,\n          cmd.stderrFile, cmd.stderrAppend\n        );\n        input = result.stdout;\n        lastStderr = result.stderr;\n        lastExitCode = result.exitCode;\n        if (lastExitCode !== 0) break;\n      }\n      return { stdout: input || '', stderr: lastStderr, exitCode: lastExitCode };\n    }\n\n    async _executeCommand(program, args, stdinIter, stdoutFile, stdoutAppend, stderrFile, stderrAppend) {\n      const pid = `${program}_${Date.now()}_${Math.random()}`;\n      const metadata = { cmd: program, args };\n      if (!this.rm.reserveProcess(pid, metadata)) {\n        const msg = `Resource limit: too many active processes (max ${this.rm.getEffectiveLimits().maxProcesses})`;\n        if (stderrFile) await this._writeToFile(stderrFile, msg, stderrAppend);\n        return { stdout: '', stderr: msg, exitCode: 127 };\n      }\n\n      const startTime = Date.now();\n      try {\n        const cmdClass = await this._getCommandClass(program);\n        if (!cmdClass) {\n          const msg = `Command not found: ${program}`;\n          if (stderrFile) await this._writeToFile(stderrFile, msg, stderrAppend);\n          return { stdout: '', stderr: msg, exitCode: 127 };\n        }\n        const stdoutColl = this._createOutputCollector();\n        const stderrColl = this._createOutputCollector();\n        const instance = new cmdClass();\n        const exitCode = await instance.execute(args, {\n          stdin: stdinIter,\n          stdout: stdoutColl,\n          stderr: stderrColl,\n          cwd: this.cwd,\n          vfs: this,\n        });\n        const stdout = stdoutColl.get();\n        const stderr = stderrColl.get();\n        if (stdoutFile) await this._writeToFile(stdoutFile, stdout, stdoutAppend);\n        if (stderrFile) await this._writeToFile(stderrFile, stderr, stderrAppend);\n        return { stdout, stderr, exitCode };\n      } finally {\n        const cpuTime = Date.now() - startTime;\n        this.rm.releaseProcess(pid, { cpuTimeMs: cpuTime });\n      }\n    }\n\n    async _getCommandClass(program) {\n      if (this._commandCache.has(program)) return this._commandCache.get(program);\n      for (const basePath of this.paths) {\n        const fullPath = `${basePath}/${program}.js`;\n        if (await this.exists(fullPath)) {\n          try {\n            const cmdClass = await this.readClass(fullPath);\n            this._commandCache.set(program, cmdClass);\n            return cmdClass;\n          } catch (err) { /* ignore */ }\n        }\n      }\n      return null;\n    }\n\n    async _writeToFile(path, content, append) {\n      const existing = append && await this.exists(path) ? await this.readFile(path) : '';\n      await this.writeFile(path, existing + content);\n    }\n\n    // ----- Command line parsing (unchanged) -----\n    _parseCommandLine(line) {\n      const pipelines = [];\n      let remaining = line.trim();\n      while (remaining.length) {\n        let pipeIdx = this._findPipe(remaining);\n        let segment = pipeIdx === -1 ? remaining : remaining.substring(0, pipeIdx);\n        const cmd = this._parseSegment(segment);\n        pipelines.push(cmd);\n        if (pipeIdx === -1) break;\n        remaining = remaining.substring(pipeIdx + 1).trim();\n      }\n      return pipelines;\n    }\n\n    _findPipe(str) {\n      let inSingle = false, inDouble = false;\n      for (let i = 0; i < str.length; i++) {\n        const c = str[i];\n        if (c === \"'\" && !inDouble) inSingle = !inSingle;\n        else if (c === '\"' && !inSingle) inDouble = !inDouble;\n        else if (c === '|' && !inSingle && !inDouble) return i;\n      }\n      return -1;\n    }\n\n    _parseSegment(seg) {\n      const tokens = this._simpleTokenize(seg);\n      const result = {\n        command: null,\n        args: [],\n        stdinFile: null,\n        stdoutFile: null,\n        stdoutAppend: false,\n        stderrFile: null,\n        stderrAppend: false,\n        hereDoc: null\n      };\n      let i = 0;\n      while (i < tokens.length) {\n        const t = tokens[i];\n        if (t === '<') { i++; result.stdinFile = tokens[i++]; }\n        else if (t === '>') { i++; result.stdoutFile = tokens[i++]; }\n        else if (t === '>>') { i++; result.stdoutFile = tokens[i++]; result.stdoutAppend = true; }\n        else if (t === '2>') { i++; result.stderrFile = tokens[i++]; }\n        else if (t === '2>>') { i++; result.stderrFile = tokens[i++]; result.stderrAppend = true; }\n        else if (t === '<<') { i++; const delim = tokens[i++]; result.hereDoc = { delimiter: delim, content: '' }; }\n        else {\n          if (result.command === null) result.command = t;\n          else result.args.push(t);\n          i++;\n        }\n      }\n      return result;\n    }\n\n    _simpleTokenize(str) {\n      const tokens = [];\n      let inSingle = false, inDouble = false, current = '';\n      for (let i = 0; i < str.length; i++) {\n        const c = str[i];\n        if (c === \"'\" && !inDouble) { inSingle = !inSingle; current += c; }\n        else if (c === '\"' && !inSingle) { inDouble = !inDouble; current += c; }\n        else if (c === ' ' && !inSingle && !inDouble) {\n          if (current) tokens.push(current);\n          current = '';\n        } else { current += c; }\n      }\n      if (current) tokens.push(current);\n      return tokens;\n    }\n\n    // ----- Cheatsheet (unchanged) -----\n    cheatsheet() {\n      const lines = [\n        '═══════════════════════════════════════════════════════════════════',\n        'KernelJS Cheatsheet (async, use await)',\n        '═══════════════════════════════════════════════════════════════════',\n        '',\n        'File operations:',\n        '  kernel.mkdir(\"/path\")',\n        '  kernel.writeFile(\"/path\", \"content\")',\n        '  const data = await kernel.readFile(\"/path\")',\n        '  const exists = await kernel.exists(\"/path\")',\n        '  await kernel.copy(\"/src\", \"/dst\")',\n        '  const items = await kernel.dir(\"/\")',\n        '  await kernel.rename(\"/old\", \"/new\")',\n        '  await kernel.delete(\"/path\")',\n        '  await kernel.saveJSON(\"/conf.json\", {key:\"val\"})',\n        '  const obj = await kernel.loadJSON(\"/conf.json\")',\n        '',\n        'Paste from clipboard / stdin:',\n        '  await kernel.paste(\"/note.md\")   // then Ctrl+V (browser) or paste + Ctrl+D (Node)',\n        '',\n        'Shell (run commands stored in /bin):',\n        '  const {stdout, stderr, exitCode} = await kernel.run(\"ls -l /\")',\n        '  await kernel.run(\"echo Hello > /greeting.txt\")',\n        '  await kernel.run(\"cat /greeting.txt | grep Hello\")',\n        '  await kernel.run(\"mkdir /tmp && cp /test.txt /tmp/\")',\n        '',\n        'ResourceManager:',\n        '  const stats = kernel.rm.stats()',\n        '  kernel.rm.setLimits({ maxProcesses: 4 })',\n        '  kernel.rm.on(\"limit_exceeded\", (e) => console.log(e))',\n        '',\n        'Installing standard commands (one‑time):',\n        '  await KernelJS.installStandardCommands(kernel);',\n        '',\n        'Running tests (static):',\n        '  const results = await KernelJS.runTests(kernel, { verbose: true });',\n        '',\n        'Example: create a file, search, and count lines:',\n        '  await kernel.writeFile(\"/data.txt\",